<ul class="navbar-nav">
    @if (Context.User.Identity.IsAuthenticated)
    {
        <li class="nav-item">
            <a class="nav-link text-dark" title="Manage">Olá Usuario</a>
        </li>
        <li class="nav-item">
            <button class="nav-link text-dark" asp-controller="Identidade" asp-action="Logout">Logout</button>
        </li>
    }
    else
    {
        <li class="nav-item" style="padding-right: 30px">
            <button type="submit" class="btn btn-light"><a class="nav-link" asp-controller="Identidade" asp-action="Registro">Crie sua conta</a></button>
        </li>
        <li class="nav-item">
            <button type="submit" class="btn btn-light"><a class="nav-link" asp-controller="Identidade" asp-action="Login">Login</a></button>
        </li>
    }
</ul>